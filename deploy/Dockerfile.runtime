FROM busybox:1.37 AS data-dir
RUN mkdir /data

FROM gcr.io/distroless/static-debian13:nonroot
COPY --chown=nonroot:nonroot --from=data-dir /data /data
COPY --chown=nonroot:nonroot dist/pasta /pasta
VOLUME ["/data"]
ENV PASTA_ADDR=:8080 PASTA_DATA_DIR=/data
EXPOSE 8080
USER nonroot:nonroot
ENTRYPOINT ["/pasta"]
